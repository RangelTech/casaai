# Exemplo de ambiente do casaai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/casaai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

CASAAI_ADMIN_KEY=
CASAAI_CAKTO_SEGREDO=
CASAAI_DEMO_SENHA=
CASAAI_LLM_KEY=
CASAAI_SEGREDO_SESSAO=
CASAAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
